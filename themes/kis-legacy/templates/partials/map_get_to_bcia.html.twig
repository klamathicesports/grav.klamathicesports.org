<script>
var infowindow_content_bccia = '<b>We are here!</b><br />5075 Fox Sparrow DR<br />Klamath Falls, OR, 97601<br />541-850-5758';
var markers = [];

let map;

async function initMap() {
	const { Map } = await google.maps.importLibrary("maps");
	const { AdvancedMarkerElement } = await google.maps.importLibrary("marker");
	const { DirectionsService } = await google.maps.importLibrary("routes");

	var map = new google.maps.Map(document.getElementById('map'), {
		mapTypeId: google.maps.MapTypeId.HYBRID,
		scrollwheel: false,
		center: new google.maps.LatLng(42.2734097,-121.8853638),
		disableDefaultUI: true,
		zoom: 12,
		mapId: "DEMO_MAP_ID",
	});
	var infoWindow = new google.maps.InfoWindow();
	var directionsService = new google.maps.DirectionsService;
	var directionsDisplay = new google.maps.DirectionsRenderer({map: map, suppressMarkers: true});

	displayBcia(map, infoWindow);
	calculateAndDisplayRoute(map, directionsDisplay, directionsService)
	
	var onChangeHandler = function() {
		clearMarkers(markers);
		displayBcia(map, infoWindow);
		calculateAndDisplayRoute(map, directionsDisplay, directionsService);
	};
	document.getElementById('end').addEventListener('change', onChangeHandler);
	document.getElementById('mode').addEventListener('change', onChangeHandler );
}

function clearMarkers(markers) {
	for (var i = 0; i < markers.length; i++) {
		markers[i].setMap(null);
	}
}

function displayBcia(map, infoWindow) {
	const imgMarkerBccia = document.createElement("img");
	imgMarkerBccia.src = "{{ url("theme://images/marker_bccia.png") }}";
	var locationBcia = new google.maps.LatLng(42.273507, -121.882861);
	var marker_bccia = new google.maps.marker.AdvancedMarkerElement({
		map: map,
		content: imgMarkerBccia,
		position: locationBcia,
	});
	markers.push(marker_bccia);

	google.maps.event.addListener(marker_bccia, 'click', function(){
		infoWindow.close();
		infoWindow.setContent(infowindow_content_bccia);
		infoWindow.open(map, marker_bccia);
	});
	infoWindow.close();
	infoWindow.setContent(infowindow_content_bccia);
	infoWindow.open(map, marker_bccia);
}

function calculateAndDisplayRoute(map, directionsDisplay, directionsService) {

	var directionsRequest = {
		origin: document.getElementById('end').value,
		destination: "Bill Collier Ice Arena, 5075 fox sparrow drive, klamath falls, or",
		travelMode: document.getElementById('mode').value
	}
	directionsService.route(directionsRequest, function(response, status) {
		if (status === google.maps.DirectionsStatus.OK) {
			document.getElementById('warnings-panel').innerHTML = '<b>' + response.routes[0].warnings + '</b>';

			var discoveredRoute = response.routes[0].legs[0];

			const imgMarkerStart = document.createElement("img");
			imgMarkerStart.src = "{{ url("theme://images/marker_start.png") }}";
			var marker_start = new google.maps.marker.AdvancedMarkerElement({
				map: map,
				content: imgMarkerStart,
				position: discoveredRoute.steps[0].start_location
			});
			markers.push(marker_start);

			directionsDisplay.setDirections(response);
		} else {
			window.alert('Directions request failed due to ' + status);
		}
	});
}

initMap();

</script>